.venv/
venv/
env/
ENV/

# --- Environment variables / secrets ---
.env
.env.*
!.env.example

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
.eggs/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Databases (local dev, e.g. SQLite) ---
*.db
*.sqlite3

# --- Alembic (keep migrations, ignore generated cache if any) ---
